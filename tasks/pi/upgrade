#!/usr/bin/env bash
#MISE description="Upgrade oh-my-pi to the latest npm release and rebuild the image"
set -euo pipefail

DOCKERFILE="${MISE_TASK_DIR}/../../Dockerfile"
DOCKER_CMD="${PI_CONTAINER_RUNTIME:-docker}"

"${DOCKER_CMD}" image inspect "${OMP_IMAGE}" > /dev/null 2>&1 || {
  echo "error: image not found — run: mise run pi:build" >&2
  exit 1
}

CURRENT=$(perl -ne 'print $1 if /ARG OMP_VERSION="([\d.]+)"/' "${DOCKERFILE}")
LATEST=$("${DOCKER_CMD}" run --rm --entrypoint bun "${OMP_IMAGE}" pm view "${OMP_PACKAGE}" version)

if [[ "${CURRENT}" == "${LATEST}" ]]; then
  echo "Already at latest oh-my-pi version: ${CURRENT}"
  exit 0
fi

echo "Upgrading oh-my-pi: ${CURRENT} -> ${LATEST}"

# perl -pi -e is cross-platform (macOS and Linux); avoids sed -i / sed -i ''
# incompatibility.
perl -pi -e "s/ARG OMP_VERSION=\"[\d.]+\"/ARG OMP_VERSION=\"${LATEST}\"/" "${DOCKERFILE}"
perl -pi -e "s/OMP_VERSION = \"[\d.]+\"/OMP_VERSION = \"${LATEST}\"/" "${MISE_TASK_DIR}/../../.mise.toml"

mise run pi:build
