#!/usr/bin/env bash
#MISE description="Remove pi global tasks from mise"
set -euo pipefail

CONF_FILE="${XDG_CONFIG_HOME:-${HOME}/.config}/mise/conf.d/omp-less-yolo.toml"

if [[ ! -f "${CONF_FILE}" ]]; then
  echo "Nothing to uninstall (${CONF_FILE} not found)."
  exit 0
fi

rm "${CONF_FILE}"

echo ""
echo "Removed ${CONF_FILE}."
echo ""
echo "The Docker image (${OMP_IMAGE}) and oh-my-pi config (${OMP_HOST_DIR}) were not touched."
echo "To remove the image:  ${PI_CONTAINER_RUNTIME:-docker} rmi ${OMP_IMAGE}"
echo "To remove oh-my-pi config:  rm -rf ~/.omp"
echo ""
